#ifndef TAYGA_HEADER_SYSTEM_ERROR
#define TAYGA_HEADER_SYSTEM_ERROR

#include <errno.h>
#include "winter_stdlib.hpp"

namespace std {
template <typename T>
struct is_error_code_enum : false_type {};

template <typename T>
struct is_error_condition_enum : false_type {};

template <>
struct is_error_code_enum<errc> : true_type {};

template <>
struct is_error_condition_enum<errc> : true_type {};

template <typename T>
inline constexpr bool is_error_code_enum_v = is_error_code_enum<T>::value;

template <typename T>
inline constexpr bool is_error_condition_enum_v = is_error_condition_enum<T>::value;

class error_category;
class error_condition;
class error_code;
const error_category& generic_category() noexcept;
const error_category& system_category() noexcept;
inline bool operator==(const error_condition& left, const error_condition& right) noexcept;

class error_category {
public:
	constexpr error_category() noexcept = default;
	virtual ~error_category() = default;

	error_category(const error_category&) = delete;
	error_category& operator=(const error_category&) = delete;

	virtual const char* name() const noexcept { return "tayga"; }
	virtual string message(int condition) const {
		return to_string(condition);
	}

	virtual error_condition default_error_condition(int condition) const noexcept;
	virtual bool equivalent(int code, const error_condition& condition) const noexcept;
};

class error_condition {
public:
	error_condition() noexcept : value_(0), category_(&generic_category()) {}
	error_condition(int value, const error_category& category) noexcept : value_(value), category_(&category) {}
	error_condition(errc value) noexcept : error_condition(static_cast<int>(value), generic_category()) {}
	template <typename ErrorConditionEnum, typename = enable_if_t<is_error_condition_enum<ErrorConditionEnum>::value>>
	error_condition(ErrorConditionEnum value) noexcept : error_condition(make_error_condition(value)) {}

	int value() const noexcept { return value_; }
	const error_category& category() const noexcept { return *category_; }
	string message() const { return category().message(value_); }
	explicit operator bool() const noexcept { return value_ != 0; }

private:
	int value_;
	const error_category* category_;
};

class error_code {
public:
	error_code() noexcept : value_(0), category_(&system_category()) {}
	error_code(int value, const error_category& category) noexcept : value_(value), category_(&category) {}
	error_code(errc value) noexcept : error_code(static_cast<int>(value), generic_category()) {}
	template <typename ErrorCodeEnum, typename = enable_if_t<is_error_code_enum<ErrorCodeEnum>::value>>
	error_code(ErrorCodeEnum value) noexcept : error_code(make_error_code(value)) {}

	void assign(int value, const error_category& category) noexcept {
		value_ = value;
		category_ = &category;
	}

	void clear() noexcept {
		value_ = 0;
		category_ = &system_category();
	}

	int value() const noexcept { return value_; }
	const error_category& category() const noexcept { return *category_; }
	error_condition default_error_condition() const noexcept { return category().default_error_condition(value_); }
	string message() const { return category().message(value_); }
	explicit operator bool() const noexcept { return value_ != 0; }

private:
	int value_;
	const error_category* category_;
};

class __tayga_generic_error_category : public error_category {
public:
	const char* name() const noexcept override { return "generic"; }
	string message(int condition) const override { return to_string(condition); }
};

class __tayga_system_error_category : public error_category {
public:
	const char* name() const noexcept override { return "system"; }
	string message(int condition) const override { return to_string(condition); }
};

inline const error_category& generic_category() noexcept {
	static __tayga_generic_error_category category;
	return category;
}

inline const error_category& system_category() noexcept {
	static __tayga_system_error_category category;
	return category;
}

inline error_condition error_category::default_error_condition(int condition) const noexcept {
	return error_condition(condition, *this);
}

inline bool error_category::equivalent(int code, const error_condition& condition) const noexcept {
	return default_error_condition(code) == condition;
}

inline bool operator==(const error_category& left, const error_category& right) noexcept {
	return &left == &right;
}

inline bool operator!=(const error_category& left, const error_category& right) noexcept {
	return !(left == right);
}

inline bool operator==(const error_code& left, const error_code& right) noexcept {
	return left.value() == right.value() && left.category() == right.category();
}

inline bool operator!=(const error_code& left, const error_code& right) noexcept {
	return !(left == right);
}

inline bool operator==(const error_condition& left, const error_condition& right) noexcept {
	return left.value() == right.value() && left.category() == right.category();
}

inline bool operator!=(const error_condition& left, const error_condition& right) noexcept {
	return !(left == right);
}

inline error_code make_error_code(errc code) noexcept {
	return error_code(static_cast<int>(code), generic_category());
}

inline error_condition make_error_condition(errc code) noexcept {
	return error_condition(static_cast<int>(code), generic_category());
}

inline bool operator==(const error_code& left, errc right) noexcept {
	return left == make_error_code(right);
}

inline bool operator==(errc left, const error_code& right) noexcept {
	return right == left;
}

inline bool operator!=(const error_code& left, errc right) noexcept {
	return !(left == right);
}

inline bool operator!=(errc left, const error_code& right) noexcept {
	return !(left == right);
}

class system_error : public runtime_error {
public:
	explicit system_error(error_code code) : runtime_error(code.message()), code_(code) {}
	system_error(error_code code, const string& what_arg) : runtime_error(what_arg), code_(code) {}
	system_error(error_code code, const char* what_arg) : runtime_error(what_arg), code_(code) {}

	const error_code& code() const noexcept { return code_; }

private:
	error_code code_;
};
}

namespace wm {
inline std::error_code make_error_code(errc code) noexcept {
	return std::make_error_code(code);
}

inline std::error_condition make_error_condition(errc code) noexcept {
	return std::make_error_condition(code);
}
}

#endif
