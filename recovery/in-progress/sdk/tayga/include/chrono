#ifndef TAYGA_HEADER_CHRONO
#define TAYGA_HEADER_CHRONO

#include "winter_stdlib.hpp"

namespace wm {
namespace chrono {
using minutes = duration<long long, ratio<60>>;
using hours = duration<long long, ratio<3600>>;

template <typename Rep>
struct treat_as_floating_point : wm::is_floating_point<Rep> {};

template <typename ToDuration, typename Clock, typename Duration>
constexpr time_point<Clock, ToDuration> time_point_cast(const time_point<Clock, Duration>& value) {
	return time_point<Clock, ToDuration>(duration_cast<ToDuration>(value.time_since_epoch()));
}

template <typename Rep1, typename Period1, typename Rep2, typename Period2>
constexpr bool operator<(duration<Rep1, Period1> left, duration<Rep2, Period2> right) noexcept {
	return duration_cast<nanoseconds>(left).count() < duration_cast<nanoseconds>(right).count();
}

template <typename Rep1, typename Period1, typename Rep2, typename Period2>
constexpr bool operator>(duration<Rep1, Period1> left, duration<Rep2, Period2> right) noexcept {
	return right < left;
}

template <typename Rep1, typename Period1, typename Rep2, typename Period2>
constexpr bool operator<=(duration<Rep1, Period1> left, duration<Rep2, Period2> right) noexcept {
	return !(right < left);
}

template <typename Rep1, typename Period1, typename Rep2, typename Period2>
constexpr bool operator>=(duration<Rep1, Period1> left, duration<Rep2, Period2> right) noexcept {
	return !(left < right);
}

template <typename Rep, typename Period, typename Scalar,
          typename = enable_if_t<is_arithmetic<Scalar>::value>>
constexpr duration<Rep, Period> operator*(duration<Rep, Period> value, Scalar multiplier) noexcept {
	return duration<Rep, Period>((Rep)(value.count() * multiplier));
}

template <typename Scalar, typename Rep, typename Period,
          typename = enable_if_t<is_arithmetic<Scalar>::value>>
constexpr duration<Rep, Period> operator*(Scalar multiplier, duration<Rep, Period> value) noexcept {
	return value * multiplier;
}

template <typename Rep1, typename Period1, typename Rep2, typename Period2>
constexpr duration<Rep1, Period1> operator%(duration<Rep1, Period1> left, duration<Rep2, Period2> right) noexcept {
	duration<Rep1, Period1> convertedRight = duration_cast<duration<Rep1, Period1>>(right);
	return duration<Rep1, Period1>(left.count() % convertedRight.count());
}

template <typename Clock, typename Duration1, typename Duration2>
constexpr nanoseconds operator-(time_point<Clock, Duration1> left, time_point<Clock, Duration2> right) noexcept {
	return duration_cast<nanoseconds>(left.time_since_epoch()) - duration_cast<nanoseconds>(right.time_since_epoch());
}

template <typename Clock, typename Duration1, typename Duration2>
constexpr bool operator<(time_point<Clock, Duration1> left, time_point<Clock, Duration2> right) noexcept {
	return duration_cast<nanoseconds>(left.time_since_epoch()) < duration_cast<nanoseconds>(right.time_since_epoch());
}

template <typename Clock, typename Duration1, typename Duration2>
constexpr bool operator>(time_point<Clock, Duration1> left, time_point<Clock, Duration2> right) noexcept {
	return right < left;
}

template <typename Clock, typename Duration1, typename Duration2>
constexpr bool operator<=(time_point<Clock, Duration1> left, time_point<Clock, Duration2> right) noexcept {
	return !(right < left);
}

template <typename Clock, typename Duration1, typename Duration2>
constexpr bool operator>=(time_point<Clock, Duration1> left, time_point<Clock, Duration2> right) noexcept {
	return !(left < right);
}

template <typename Clock, typename Duration1, typename Duration2>
constexpr bool operator==(time_point<Clock, Duration1> left, time_point<Clock, Duration2> right) noexcept {
	return duration_cast<nanoseconds>(left.time_since_epoch()).count() == duration_cast<nanoseconds>(right.time_since_epoch()).count();
}

template <typename Clock, typename Duration1, typename Duration2>
constexpr bool operator!=(time_point<Clock, Duration1> left, time_point<Clock, Duration2> right) noexcept {
	return !(left == right);
}
}
}

#endif
