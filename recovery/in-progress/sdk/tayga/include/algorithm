#ifndef TAYGA_HEADER_ALGORITHM
#define TAYGA_HEADER_ALGORITHM

#include "winter_stdlib.hpp"

namespace std {
template <typename ForwardIt1, typename ForwardIt2>
ForwardIt1 search(ForwardIt1 first, ForwardIt1 last, ForwardIt2 pattern_first, ForwardIt2 pattern_last) {
	if (pattern_first == pattern_last) {
		return first;
	}
	for (; first != last; ++first) {
		ForwardIt1 current = first;
		ForwardIt2 pattern = pattern_first;
		while (current != last && pattern != pattern_last && *current == *pattern) {
			++current;
			++pattern;
		}
		if (pattern == pattern_last) {
			return first;
		}
		if (current == last) {
			return last;
		}
	}
	return last;
}

template <typename ForwardIt1, typename ForwardIt2, typename BinaryPredicate>
ForwardIt1 search(ForwardIt1 first, ForwardIt1 last, ForwardIt2 pattern_first, ForwardIt2 pattern_last, BinaryPredicate predicate) {
	if (pattern_first == pattern_last) {
		return first;
	}
	for (; first != last; ++first) {
		ForwardIt1 current = first;
		ForwardIt2 pattern = pattern_first;
		while (current != last && pattern != pattern_last && predicate(*current, *pattern)) {
			++current;
			++pattern;
		}
		if (pattern == pattern_last) {
			return first;
		}
		if (current == last) {
			return last;
		}
	}
	return last;
}

template <typename ForwardIt>
ForwardIt adjacent_find(ForwardIt first, ForwardIt last) {
	if (first == last) {
		return last;
	}
	ForwardIt next = first;
	++next;
	for (; next != last; ++first, ++next) {
		if (*first == *next) {
			return first;
		}
	}
	return last;
}

template <typename ForwardIt, typename BinaryPredicate>
ForwardIt adjacent_find(ForwardIt first, ForwardIt last, BinaryPredicate predicate) {
	if (first == last) {
		return last;
	}
	ForwardIt next = first;
	++next;
	for (; next != last; ++first, ++next) {
		if (predicate(*first, *next)) {
			return first;
		}
	}
	return last;
}

template <typename ForwardIt1, typename ForwardIt2>
void iter_swap(ForwardIt1 left, ForwardIt2 right) {
	std::swap(*left, *right);
}

template <typename InputIt1, typename InputIt2>
bool includes(InputIt1 first1, InputIt1 last1, InputIt2 first2, InputIt2 last2) {
	for (; first2 != last2; ++first1) {
		if (first1 == last1 || *first2 < *first1) {
			return false;
		}
		if (!(*first1 < *first2)) {
			++first2;
		}
	}
	return true;
}

template <typename InputIt1, typename InputIt2, typename Compare>
bool includes(InputIt1 first1, InputIt1 last1, InputIt2 first2, InputIt2 last2, Compare compare) {
	for (; first2 != last2; ++first1) {
		if (first1 == last1 || compare(*first2, *first1)) {
			return false;
		}
		if (!compare(*first1, *first2)) {
			++first2;
		}
	}
	return true;
}

template <typename ForwardIt, typename UnaryPredicate>
ForwardIt partition(ForwardIt first, ForwardIt last, UnaryPredicate predicate) {
	while (first != last && predicate(*first)) {
		++first;
	}
	if (first == last) {
		return first;
	}
	for (ForwardIt scan = first; scan != last; ++scan) {
		if (predicate(*scan)) {
			std::iter_swap(first, scan);
			++first;
		}
	}
	return first;
}

template <typename ForwardIt, typename Predicate>
ForwardIt partition_point(ForwardIt first, ForwardIt last, Predicate predicate) {
	while (first != last) {
		ForwardIt middle = first;
		size_t distance = 0;
		for (ForwardIt scan = first; scan != last; ++scan) {
			++distance;
		}
		size_t half = distance / 2;
		for (size_t index = 0; index < half; ++index) {
			++middle;
		}
		if (predicate(*middle)) {
			first = middle;
			++first;
		} else {
			last = middle;
		}
	}
	return first;
}

template <typename InputIt, typename ForwardIt>
ForwardIt uninitialized_copy(InputIt first, InputIt last, ForwardIt output) {
	for (; first != last; ++first, ++output) {
		new (static_cast<void*>(&*output)) remove_reference_t<decltype(*output)>(*first);
	}
	return output;
}

template <typename InputIt, typename ForwardIt>
ForwardIt uninitialized_move(InputIt first, InputIt last, ForwardIt output) {
	for (; first != last; ++first, ++output) {
		new (static_cast<void*>(&*output)) remove_reference_t<decltype(*output)>(std::move(*first));
	}
	return output;
}

template <typename ForwardIt, typename Size, typename T>
ForwardIt uninitialized_fill_n(ForwardIt first, Size count, const T& value) {
	for (Size index = 0; index < count; ++index, ++first) {
		new (static_cast<void*>(&*first)) remove_reference_t<decltype(*first)>(value);
	}
	return first;
}

template <typename ForwardIt, typename T>
void uninitialized_fill(ForwardIt first, ForwardIt last, const T& value) {
	for (; first != last; ++first) {
		new (static_cast<void*>(&*first)) remove_reference_t<decltype(*first)>(value);
	}
}

template <typename RandomIt>
void stable_sort(RandomIt first, RandomIt last) {
	wm::sort(first, last);
}

template <typename RandomIt, typename Compare>
void stable_sort(RandomIt first, RandomIt last, Compare compare) {
	wm::sort(first, last, compare);
}
}

#endif
